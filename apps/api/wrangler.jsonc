{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mdn-eye-clinic-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "vars": {
    "AUTH_BASE_URL": "http://127.0.0.1:5173",
    "WEBSITE_ORIGIN": "http://127.0.0.1:4321"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mdn-eye-clinic-local",
      // Local emulation only. Replace with an approved environment's database before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}

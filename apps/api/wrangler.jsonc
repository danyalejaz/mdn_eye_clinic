{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mdn-eye-clinic-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-27",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}

{
  "name": "@clinic/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "dev:portal-preview": "wrangler dev --local --ip 127.0.0.1 --port 8790 --config wrangler.portal-preview.jsonc",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file test/fixtures/public-catalog.sql",
    "admin:bootstrap:local": "node scripts/bootstrap-admin.ts",
    "test": "vitest run --maxWorkers=3"
  },
  "dependencies": {
    "better-auth": "1.7.28",
    "hono": "4.13.23",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "typescript": "6.0.3",
    "vitest": "5.1.2",
    "wrangler": "4.168.0"
  }
}

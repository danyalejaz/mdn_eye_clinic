---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Iris from "../components/Iris.astro";
import Booking from "../components/Booking.astro";
import Mark from "../components/Mark.astro";
import { faqs, portalUrl } from "../data/clinic";
import { formatFee, loadCatalog } from "../lib/catalog";

const { clinic, doctors, services } = await loadCatalog();
const clinicName = clinic?.name ?? "Mardan Eye Clinic";
const hours = clinic?.hoursSummary ?? "Hours not listed";
const phone = clinic?.phone ?? null;
const address = clinic?.address ?? "Street address not listed";
const directions = clinic?.address
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${clinicName}, ${clinic.address}`)}`
  : null;
const steps = [
  { title: "Find a time", text: "Choose a doctor and day to see available appointments." },
  { title: "Confirm your visit", text: "Sign in to the patient portal to reserve a slot and get your booking reference." },
  { title: "Check in at reception", text: "Bring your booking reference, glasses and any previous eye reports you have." },
];
---

<Base title={`${clinicName} | Eye care in Mardan`} description="Explore eye care services and consultation fees, find a doctor and check appointment availability in Mardan.">
  <SiteHeader {portalUrl} {clinicName} />
  <main id="main-content" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="signal"></span> Mardan, Pakistan</p>
          <h1 id="hero-title">A clearer<br />view of <em>care.</em></h1>
          <p class="intro">Eye care close to home. Find a doctor, see consultation fees and choose a time that works for you.</p>
          <div class="actions">
            <a class="button primary" href="#book">Find an appointment <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#care">Explore services <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="hero-art" aria-hidden="true">
          <span class="art-top"><span>✦</span> THE IRIS</span>
          <Iris />
          <span class="art-bottom">01 / FIELD OF VISION</span>
        </div>
      </div>
    </section>

    <div class="wrap booking-wrap">
      <Booking {doctors} {portalUrl} />
    </div>

    <section id="care" class="section wrap" aria-labelledby="care-title">
      <div class="section-head">
        <div>
          <p class="eyebrow"><span class="section-number">01</span> Eye care services</p>
          <h2 id="care-title">Care for your vision.</h2>
        </div>
        <p>Browse the clinic’s services and see the published fees before you book.</p>
      </div>
      {services.length ? (
        <ul class="card-grid" role="list">
          {services.map((service) => (
            <li class="service-card" id={`service-${service.slug}`}>
              <Mark />
              <p class="card-label">{service.departmentName}</p>
              <h3>{service.name}</h3>
              {service.description && <p class="card-description">{service.description}</p>}
              <div class="card-foot"><span>Published fee</span><strong>{formatFee(service.feeMinor)}</strong></div>
            </li>
          ))}
        </ul>
      ) : <p class="empty">Service listings are currently unavailable.</p>}
    </section>

    <section id="doctors" class="section section-tint" aria-labelledby="doctors-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow"><span class="section-number">02</span> Your care team</p>
            <h2 id="doctors-title">Meet the doctors.</h2>
          </div>
          <p>See each doctor’s specialty and consultation fee, then check their next available times.</p>
        </div>
        {doctors.length ? (
          <ul class="card-grid doctor-grid" role="list">
            {doctors.map((doctor) => (
              <li class="doctor-card">
                {doctor.photoUrl ? (
                  <img class="doctor-photo" src={doctor.photoUrl} alt="" width="112" height="136" loading="lazy" decoding="async" />
                ) : <div class="doctor-placeholder"><Mark /></div>}
                <div class="doctor-copy">
                  <p class="card-label">{doctor.departmentName}</p>
                  <h3>{doctor.displayName}</h3>
                  <p>{doctor.specialty}{doctor.qualifications ? ` · ${doctor.qualifications}` : ""}</p>
                  <p>Consultation <strong>{formatFee(doctor.feeMinor)}</strong></p>
                  <a href="#book" data-pick-doctor={doctor.id} class="text-link">
                    See open times <span class="visually-hidden">with {doctor.displayName}</span><span aria-hidden="true">↗</span>
                  </a>
                </div>
              </li>
            ))}
          </ul>
        ) : <p class="empty">Doctor listings are currently unavailable.</p>}
      </div>
    </section>

    <section id="visit" class="section wrap" aria-labelledby="visit-title">
      <div class="section-head">
        <div>
          <p class="eyebrow"><span class="section-number">03</span> Plan your visit</p>
          <h2 id="visit-title">Know what to expect.</h2>
        </div>
      </div>
      <div class="visit-grid">
        <ol class="visit-steps" role="list">
          {steps.map((step, index) => (
            <li><span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <div><h3>{step.title}</h3><p>{step.text}</p></div>
            </li>
          ))}
        </ol>
        <div class="location">
          <p class="eyebrow">Clinic information</p>
          <h3>{clinicName}</h3>
          <dl>
            <div><dt>Address</dt><dd>{address}</dd></div>
            <div><dt>Hours</dt><dd>{hours}</dd></div>
            {phone && <div><dt>Phone</dt><dd><a href={`tel:${phone}`}>{phone}</a></dd></div>}
          </dl>
          {directions && <a class="button light" href={directions}>Get directions <span aria-hidden="true">↗</span></a>}
        </div>
      </div>
    </section>

    <section id="questions" class="section section-tint" aria-labelledby="questions-title">
      <div class="wrap faq-grid">
        <div>
          <p class="eyebrow"><span class="section-number">04</span> Patient questions</p>
          <h2 id="questions-title">Before you come.</h2>
          <p class="faq-intro">Practical answers for your next appointment.</p>
        </div>
        <div class="faq-list">
          {faqs.map((item) => (
            <details open={item.open}>
              <summary>{item.question}<span aria-hidden="true"></span></summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter {portalUrl} {clinicName} {phone} {address} />
</Base>

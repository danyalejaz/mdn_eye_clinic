---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Mark from "../components/Mark.astro";
import { formatFee, loadCatalog } from "../lib/catalog";

const { clinic, doctors, services } = await loadCatalog();
const clinicName = clinic?.name ?? "Mardan Eye Clinic";
const phone = clinic?.phone ?? null;
const address = clinic?.address || "Contact the clinic for the address.";
---

<Base title={`${clinicName} | Eye care in Mardan`} description="Explore eye care services and consultation fees, find a doctor and check appointment availability in Mardan.">
  <SiteHeader {clinicName} />
  <main id="main-content" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Outpatient clinic · Mardan</p>
          <h1 id="hero-title">A little more clarity for your eye care.</h1>
          <p class="intro">Our mission, your vision. Contact our clinic in Mardan to arrange your visit.</p>
          <div class="actions">
            <a class="button light" href="#book">Find an appointment <span aria-hidden="true">→</span></a>
            <a class="hero-secondary" href="/visit/">Plan your visit <span aria-hidden="true">↗</span></a>
          </div>
          <p class="hero-caption">Mardan, Pakistan <span aria-hidden="true">/</span> Patient appointments</p>
        </div>
        <figure class="clinic-photo">
          <img src="/eye-examination.webp" width="1280" height="850" fetchpriority="high" alt="An eye examination using a slit lamp" />
          <figcaption>Illustrative image · <a href="https://commons.wikimedia.org/wiki/File:Slit-lamp_Examination.jpg">JeevaMuthuramalingam</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a> (cropped and converted)</figcaption>
        </figure>
      </div>
    </section>

    <nav class="wrap patient-guide" aria-label="Patient guide">
      <a href="/services/">Services and fees <span aria-hidden="true">→</span></a>
      <a href="/doctors/">Find a doctor <span aria-hidden="true">→</span></a>
      <a href="/visit/">Hours and directions <span aria-hidden="true">→</span></a>
    </nav>

    <section class="home-intro section wrap" aria-labelledby="welcome-title">
      <div><p class="eyebrow">Welcome to {clinicName}</p><h2 id="welcome-title">Care begins with a conversation.</h2></div>
      <div class="home-intro-copy">
        <p>Whether you’re arranging a consultation or returning for a follow-up, the details should be easy to find.</p>
        <p>Contact our clinic for current services, consultation fees and appointment information.</p>
        <a class="text-link" href="/patient-guide/">What to expect at your visit →</a>
      </div>
    </section>

    <section id="care" class="section wrap" aria-labelledby="care-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">Explore your care</p>
          <h2 id="care-title">Eye care services</h2>
        </div>
        <p>Browse the clinic’s services and see the published fees before you book.</p>
      </div>
      {services.length ? (
        <ul class="card-grid" role="list">
          {services.map((service) => (
            <li class="service-card" id={`service-${service.slug}`}>
              <p class="card-label">{service.departmentName}</p>
              <h3>{service.name}</h3>
              {service.description && <p class="card-description">{service.description}</p>}
              <div class="card-foot"><span>Published fee</span><strong>{formatFee(service.feeMinor)}</strong></div>
            </li>
          ))}
        </ul>
      ) : <p class="empty">Service listings are currently unavailable.</p>}
      <a class="text-link home-more" href="/services/">Explore all services and fees →</a>
    </section>

    <section class="home-story section-tint" aria-labelledby="story-title">
      <div class="wrap home-story-grid">
        <figure class="home-story-photo">
          <img src="/slit-lamp.webp" width="960" height="1280" loading="lazy" decoding="async" alt="A slit lamp, an instrument used to examine the eye" />
          <figcaption>Illustrative image · <a href="https://commons.wikimedia.org/wiki/File:Retina_Group_slit_lamp_(side_view).jpg">Ben Schumin</a> · <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a> (crop)</figcaption>
        </figure>
        <div class="home-story-copy">
          <p class="eyebrow">A better prepared visit</p>
          <h2 id="story-title">Bring your questions. We’ll help you get started.</h2>
          <p>Knowing what to bring can make the day feel simpler. Gather your glasses, previous eye reports and a list of the medicines or eye drops you use.</p>
          <p>It helps to note what you’ve noticed about your vision and any questions you want to discuss with your doctor.</p>
          <a class="text-link" href="/patient-guide/">Read the patient guide →</a>
        </div>
      </div>
    </section>

    <section id="doctors" class="section section-tint" aria-labelledby="doctors-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">People behind your care</p>
            <h2 id="doctors-title">Our doctors</h2>
          </div>
          <p>See each doctor’s specialty and consultation fee, then check their next available times.</p>
        </div>
        {doctors.length ? (
          <ul class="card-grid doctor-grid" role="list">
            {doctors.map((doctor) => (
              <li class="doctor-card">
                {doctor.photoUrl ? (
                  <img class="doctor-photo" src={doctor.photoUrl} alt="" width="112" height="136" loading="lazy" decoding="async" />
                ) : <div class="doctor-placeholder"><Mark /></div>}
                <div class="doctor-copy">
                  <p class="card-label">{doctor.departmentName}</p>
                  <h3>{doctor.displayName}</h3>
                  <p>{doctor.specialty}{doctor.qualifications ? ` · ${doctor.qualifications}` : ""}</p>
                  <p>Consultation <strong>{formatFee(doctor.feeMinor)}</strong></p>
                  <a href="#book" data-pick-doctor={doctor.id} class="text-link">
                    See open times <span class="visually-hidden">with {doctor.displayName}</span><span aria-hidden="true">↗</span>
                  </a>
                </div>
              </li>
            ))}
          </ul>
        ) : <p class="empty">Doctor listings are currently unavailable.</p>}
        <a class="text-link home-more" href="/doctors/">Meet all doctors →</a>
      </div>
    </section>

    <section class="section wrap journey" aria-labelledby="journey-title">
      <div class="section-head">
        <div><p class="eyebrow">Your visit, step by step</p><h2 id="journey-title">Making room for care.</h2></div>
        <p>A few simple steps to help you feel ready for your appointment.</p>
      </div>
      <ol class="journey-grid">
        <li><span>01</span><h3>Find a doctor</h3><p>Explore specialties and consultation fees to choose who you’d like to see.</p><a class="text-link" href="/doctors/">View doctors →</a></li>
        <li><span>02</span><h3>Choose a time</h3><p>Call the clinic to ask about available appointment times.</p><a class="text-link" href="#book">Contact the clinic →</a></li>
        <li><span>03</span><h3>Prepare for your visit</h3><p>Bring your booking reference, glasses, medication list and any previous eye reports.</p><a class="text-link" href="/patient-guide/">See what to bring →</a></li>
      </ol>
    </section>

    <div class="section wrap home-booking">
      <div class="home-booking-heading"><p class="eyebrow">Appointments</p><h2>Let’s find a time for you.</h2><p>Please contact the clinic to arrange your visit.</p></div>
      <div id="book" class="booking"><h3>Contact the clinic</h3><p>Call <a href="tel:0937867538">0937-867538</a> or WhatsApp <a href="https://wa.me/923015801666">0301-5801666</a> for appointments.</p></div>
    </div>
    <section id="visit" class="section wrap" aria-labelledby="visit-title">
      <div class="section-head">
        <div>
          <h2 id="visit-title">Visiting the clinic</h2>
          <p>Coming for the first time? Check what to bring, where to go and which questions to ask before you leave.</p>
        </div>
      </div>
      <div class="actions">
        <a class="text-link" href="/patient-guide/">Read the patient guide →</a>
        <a class="button primary" href="/visit/">Address, hours and directions <span aria-hidden="true">→</span></a>
        <a id="questions" class="text-link" href="/visit/#questions">Common questions <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
  <SiteFooter {clinicName} {phone} {address} />
</Base>

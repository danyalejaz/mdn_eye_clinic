---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Booking from "../components/Booking.astro";
import Mark from "../components/Mark.astro";
import { portalUrl } from "../data/clinic";
import { formatFee, loadCatalog } from "../lib/catalog";

const { clinic, doctors, services } = await loadCatalog();
const clinicName = clinic?.name ?? "Mardan Eye Clinic";
const phone = clinic?.phone ?? null;
const address = clinic?.address ?? "Street address not listed";
---

<Base title={`${clinicName} | Eye care in Mardan`} description="Explore eye care services and consultation fees, find a doctor and check appointment availability in Mardan.">
  <SiteHeader {portalUrl} {clinicName} />
  <main id="main-content" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Outpatient clinic · Mardan</p>
          <h1 id="hero-title">Eye care in Mardan</h1>
          <p class="intro">Find an eye specialist, check consultation fees and book a visit to the clinic.</p>
          <div class="actions">
            <a class="button light" href="#book">Book an appointment <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <figure class="clinic-photo">
          <img src="/slit-lamp.webp" width="960" height="1280" fetchpriority="high" alt="Side view of a slit lamp used in eye examinations" />
          <figcaption>Slit lamp · <a href="https://commons.wikimedia.org/wiki/File:Retina_Group_slit_lamp_(side_view).jpg">Ben Schumin</a> · <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a> (crop)</figcaption>
        </figure>
      </div>
    </section>

    <nav class="wrap patient-guide" aria-label="Patient guide">
      <a href="#care">Services and fees <span aria-hidden="true">→</span></a>
      <a href="#doctors">Find a doctor <span aria-hidden="true">→</span></a>
      <a href="/visit/">Hours and directions <span aria-hidden="true">→</span></a>
    </nav>

    <section id="care" class="section wrap" aria-labelledby="care-title">
      <div class="section-head">
        <div>
          <h2 id="care-title">Eye care services</h2>
        </div>
        <p>Browse the clinic’s services and see the published fees before you book.</p>
      </div>
      {services.length ? (
        <ul class="card-grid" role="list">
          {services.map((service) => (
            <li class="service-card" id={`service-${service.slug}`}>
              <p class="card-label">{service.departmentName}</p>
              <h3>{service.name}</h3>
              {service.description && <p class="card-description">{service.description}</p>}
              <div class="card-foot"><span>Published fee</span><strong>{formatFee(service.feeMinor)}</strong></div>
            </li>
          ))}
        </ul>
      ) : <p class="empty">Service listings are currently unavailable.</p>}
    </section>

    <section id="doctors" class="section section-tint" aria-labelledby="doctors-title">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2 id="doctors-title">Our doctors</h2>
          </div>
          <p>See each doctor’s specialty and consultation fee, then check their next available times.</p>
        </div>
        {doctors.length ? (
          <ul class="card-grid doctor-grid" role="list">
            {doctors.map((doctor) => (
              <li class="doctor-card">
                {doctor.photoUrl ? (
                  <img class="doctor-photo" src={doctor.photoUrl} alt="" width="112" height="136" loading="lazy" decoding="async" />
                ) : <div class="doctor-placeholder"><Mark /></div>}
                <div class="doctor-copy">
                  <p class="card-label">{doctor.departmentName}</p>
                  <h3>{doctor.displayName}</h3>
                  <p>{doctor.specialty}{doctor.qualifications ? ` · ${doctor.qualifications}` : ""}</p>
                  <p>Consultation <strong>{formatFee(doctor.feeMinor)}</strong></p>
                  <a href="#book" data-pick-doctor={doctor.id} class="text-link">
                    See open times <span class="visually-hidden">with {doctor.displayName}</span><span aria-hidden="true">↗</span>
                  </a>
                </div>
              </li>
            ))}
          </ul>
        ) : <p class="empty">Doctor listings are currently unavailable.</p>}
      </div>
    </section>

    <div class="section wrap">
      <Booking {doctors} {portalUrl} />
    </div>
    <section id="visit" class="section wrap" aria-labelledby="visit-title">
      <div class="section-head">
        <div>
          <h2 id="visit-title">Visiting the clinic</h2>
        </div>
      </div>
      <div class="actions">
        <a class="button primary" href="/visit/">Address, hours and directions <span aria-hidden="true">→</span></a>
        <a id="questions" class="text-link" href="/visit/#questions">Common questions <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
  <SiteFooter {portalUrl} {clinicName} {phone} {address} />
</Base>

---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { faqs, images, portalUrl } from "../data/clinic";
import { formatFee, loadCatalog } from "../lib/catalog";

const { clinic, doctors, services } = await loadCatalog();
const clinicName = clinic?.name ?? "Mardan Eye Clinic";
const hours = clinic?.hoursSummary ?? "Hours appear when the clinic publishes them";
const phone = clinic?.phone ?? null;
const address = clinic?.address ?? "The street address is not published yet.";
const departments = [...new Map(doctors.map((doctor) => [doctor.departmentSlug, doctor.departmentName])).entries()];
const locationAnswer = clinic
  ? `${clinic.name} is at ${clinic.address}.${clinic.hoursSummary ? ` ${clinic.hoursSummary}.` : ""}`
  : "The address and hours appear in the visit section when the clinic publishes them.";
const questions = [
  ...faqs.filter((item) => !item.question.startsWith("Where")),
  { question: "Where are you, and when are you open?", answer: locationAnswer },
];
const steps = [
  ["01", "Look up a time", "Published doctors and open slots are listed here. Nothing is reserved yet."],
  ["02", "Confirm it", "Sign in and choose the slot. You receive a booking reference when it is accepted."],
  ["03", "Come for the visit", "Bring that reference. Reception finds the appointment from it."],
];
---

<Base
  title={`${clinicName} — Eye clinic in Mardan`}
  description="Outpatient eye care in Mardan. See published doctors, fees, and open times, then confirm a visit."
>
  <SiteHeader portalUrl={portalUrl} clinicName={clinicName} hours={hours} phone={phone} />

  <main id="main-content" class="flex-1 pb-24 lg:pb-0">
    <section class="lg:grid lg:grid-cols-2 lg:min-h-[calc(100vh-68px)]">
      <div class="flex flex-col justify-end gap-lg px-lg lg:px-4xl pt-3xl pb-xl lg:py-4xl bg-ivory">
        <p class="kicker">Mardan · Asia/Karachi</p>
        <h1 class="display text-editorial-ink max-w-[12ch]">An hour for your eyes.</h1>
        <p class="max-w-[36rem] text-[1.125rem] leading-relaxed text-editorial-muted">
          {clinicName} publishes its doctors, fees, and open times here. A slot is yours only after you confirm it.
        </p>
        <div class="flex flex-wrap items-center gap-xl">
          <a href="#doctors" class="btn-line">Meet the doctors</a>
          {phone ? <a href={`tel:${phone}`} class="text-[15px] tabular-nums text-editorial-muted hover:text-editorial-ink">{phone}</a> : null}
        </div>
        <p class="text-[13px] text-editorial-muted">Scheduled visits only. This is not an emergency service.</p>
      </div>
      <div class="relative bg-sage">
        <div class="relative h-[78vw] lg:absolute lg:inset-0 lg:h-auto">
          <img src={images.hero} alt="A physician in a clinic coat" class="media absolute inset-0 w-full h-full object-cover object-[center_20%]" width="1400" height="1600" />
        </div>
        <form id="book" data-portal-url={portalUrl} data-api-base={import.meta.env.PUBLIC_API_URL ?? ""} class="relative z-10 mx-lg -mt-16 mb-lg lg:absolute lg:inset-x-xl lg:bottom-xl lg:mx-0 lg:mb-0 lg:mt-0 bg-surface border-t-2 border-gold p-lg flex flex-col gap-md shadow-[0_24px_60px_rgba(16,20,22,0.18)]">
          <div>
            <h2 class="font-editorial text-[1.7rem] leading-none tracking-[-0.03em]">Find a time</h2>
            <p class="mt-xs text-[14px] text-editorial-muted">Confirming happens after sign-in.</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-sm">
            <label class="flex flex-col gap-xs sm:col-span-2">
              <span class="kicker">Department</span>
              <select name="department" class="field">
                <option value="">All departments</option>
                {departments.map(([slug, name]) => <option value={slug}>{name}</option>)}
              </select>
            </label>
            <label class="flex flex-col gap-xs">
              <span class="kicker">Doctor</span>
              <select name="doctorId" class="field">
                <option value="">Any published doctor</option>
                {doctors.map((doctor) => (
                  <option value={doctor.id} data-department={doctor.departmentSlug}>{doctor.displayName}</option>
                ))}
              </select>
            </label>
            <label class="flex flex-col gap-xs">
              <span class="kicker">Date</span>
              <input type="date" name="date" required class="field tabular-nums" />
            </label>
          </div>
          <button type="submit" class="btn-ink">Show open times</button>
          <div id="availability-results" hidden class="border-t border-editorial-border pt-sm text-[15px]"></div>
        </form>
      </div>
    </section>

    <section class="bg-surface border-y border-editorial-border" aria-label="Clinic facts">
      <dl class="max-w-editorial mx-auto px-lg lg:px-4xl grid grid-cols-1 md:grid-cols-3">
        <div class="py-xl md:pr-xl md:border-r border-editorial-border">
          <dt class="kicker">Place</dt>
          <dd class="mt-sm font-editorial text-[1.65rem] leading-tight tracking-[-0.03em]">{address}</dd>
        </div>
        <div class="py-xl md:px-xl md:border-r border-editorial-border border-t md:border-t-0">
          <dt class="kicker">Hours</dt>
          <dd class="mt-sm font-editorial text-[1.65rem] leading-tight tracking-[-0.03em]">{hours}</dd>
        </div>
        <div class="py-xl md:pl-xl border-t md:border-t-0">
          <dt class="kicker">Fees</dt>
          <dd class="mt-sm font-editorial text-[1.65rem] leading-tight tracking-[-0.03em]">In PKR, before you book</dd>
        </div>
      </dl>
    </section>

    <section id="care" class="bg-ivory">
      <div class="max-w-editorial mx-auto px-lg lg:px-4xl py-4xl lg:py-5xl grid grid-cols-1 lg:grid-cols-12 gap-2xl">
        <div class="lg:col-span-4 lg:sticky lg:top-28 self-start flex flex-col gap-md">
          <p class="kicker">Care</p>
          <h2 class="section-title">What you can book.</h2>
          <p class="text-editorial-muted text-[17px] leading-relaxed max-w-[28rem]">Fees are the published clinic record. Draft services stay off this page.</p>
        </div>
        <div class="lg:col-span-8">
          {services.length === 0 ? (
            <p class="text-editorial-muted">No services are published yet.</p>
          ) : (
            <ul class="border-t border-editorial-ink">
              {services.map((service, index) => (
                <li class="grid grid-cols-1 sm:grid-cols-[auto_1fr_auto] gap-md sm:gap-xl items-baseline py-lg border-b border-editorial-border">
                  <span class="font-editorial text-gold tabular-nums text-[1.25rem]">{String(index + 1).padStart(2, "0")}</span>
                  <div>
                    <h3 class="font-editorial text-[1.85rem] leading-tight tracking-[-0.03em]">{service.name}</h3>
                    <p class="mt-xs text-editorial-muted">{service.description ?? service.departmentName}</p>
                  </div>
                  <p class="font-label tabular-nums sm:text-right">{formatFee(service.feeMinor)}</p>
                </li>
              ))}
            </ul>
          )}
          <a href="#book" class="btn-ink mt-xl">Book this care</a>
        </div>
      </div>
    </section>

    <section id="doctors" class="bg-surface border-y border-editorial-border">
      <div class="max-w-editorial mx-auto px-lg lg:px-4xl pt-4xl lg:pt-5xl pb-2xl flex flex-col md:flex-row md:items-end justify-between gap-lg">
        <div class="max-w-[36rem] flex flex-col gap-md">
          <p class="kicker">Doctors</p>
          <h2 class="section-title">Who you will see.</h2>
        </div>
        <p class="max-w-[24rem] text-editorial-muted">Names, specialties, and consultation fees are published by the clinic.</p>
      </div>
      {doctors.length === 0 ? (
        <p class="max-w-editorial mx-auto px-lg lg:px-4xl pb-4xl text-editorial-muted">No doctors are published yet.</p>
      ) : (
        <div class="flex flex-col">
          {doctors.map((doctor, index) => (
            <article class="grid grid-cols-1 lg:grid-cols-2 border-t border-editorial-border min-h-[520px]">
              <div class:list={["relative min-h-[360px] bg-sage overflow-hidden", index % 2 === 1 && "lg:order-2"]}>
                <img src={doctor.photoUrl ?? (index % 2 === 0 ? images.portraitA : images.portraitB)} alt="" class="media absolute inset-0 w-full h-full object-cover object-top" width="900" height="1100" />
              </div>
              <div class="flex flex-col justify-center gap-md px-lg lg:px-4xl py-3xl bg-surface">
                <p class="kicker">{doctor.departmentName}</p>
                <h3 class="font-editorial text-[clamp(2.4rem,4vw,3.6rem)] leading-none tracking-[-0.03em]">{doctor.displayName}</h3>
                <p class="text-[18px]">{doctor.specialty}</p>
                {doctor.qualifications ? <p class="text-editorial-muted">{doctor.qualifications}</p> : null}
                <p class="tabular-nums text-editorial-muted">Consultation {formatFee(doctor.feeMinor)}</p>
                <a href="#book" data-pick-doctor={doctor.id} class="pick-doctor btn-line">See open times</a>
              </div>
            </article>
          ))}
        </div>
      )}
    </section>

    <section id="visit" class="bg-ivory">
      <div class="max-w-editorial mx-auto px-lg lg:px-4xl py-4xl lg:py-5xl">
        <p class="kicker">The visit</p>
        <h2 class="section-title mt-md max-w-[18ch]">From an open hour to a confirmed visit.</h2>
        <ol class="mt-3xl grid grid-cols-1 md:grid-cols-3 gap-2xl">
          {steps.map(([number, title, copy]) => (
            <li class="border-t border-gold pt-lg flex flex-col gap-sm">
              <span class="font-editorial text-[2.75rem] leading-none tracking-[-0.04em] text-primary">{number}</span>
              <h3 class="font-editorial text-[1.7rem] tracking-[-0.03em]">{title}</h3>
              <p class="text-editorial-muted leading-relaxed">{copy}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="bg-surface border-y border-editorial-border">
      <div class="max-w-editorial mx-auto px-lg lg:px-4xl py-4xl lg:py-5xl grid grid-cols-1 lg:grid-cols-12 gap-2xl">
        <div class="lg:col-span-4 flex flex-col gap-md">
          <p class="kicker">Find us</p>
          <h2 class="section-title">{clinicName}</h2>
        </div>
        <div class="lg:col-span-8 flex flex-col gap-md">
          <p class="font-editorial text-[clamp(1.8rem,3vw,2.6rem)] leading-tight tracking-[-0.03em] max-w-[18ch]">{address}</p>
          <dl class="border-t border-editorial-ink max-w-[36rem]">
            <div class="flex justify-between gap-lg py-md border-b border-editorial-border">
              <dt class="text-editorial-muted">Hours</dt>
              <dd class="text-right">{hours}</dd>
            </div>
            <div class="flex justify-between gap-lg py-md border-b border-editorial-border">
              <dt class="text-editorial-muted">Phone</dt>
              <dd>{phone ? <a href={`tel:${phone}`} class="tabular-nums hover:text-primary">{phone}</a> : "Not published"}</dd>
            </div>
            <div class="flex justify-between gap-lg py-md border-b border-editorial-border">
              <dt class="text-editorial-muted">Time zone</dt>
              <dd>Asia/Karachi</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section id="questions" class="bg-ivory">
      <div class="max-w-editorial mx-auto px-lg lg:px-4xl py-4xl lg:py-5xl grid grid-cols-1 lg:grid-cols-12 gap-2xl">
        <div class="lg:col-span-4">
          <p class="kicker">Questions</p>
          <h2 class="section-title mt-md">Before you come.</h2>
        </div>
        <div class="lg:col-span-8 border-t border-editorial-ink">
          {questions.map((item) => (
            <div class="faq-item border-b border-editorial-border">
              <button type="button" class="faq-toggle w-full flex items-center justify-between gap-lg py-lg text-left" aria-expanded={item.open ? "true" : "false"}>
                <span class="font-editorial text-[1.45rem] leading-tight tracking-[-0.02em]">{item.question}</span>
                <span class="faq-icon text-gold text-[1.5rem] leading-none" aria-hidden="true">{item.open ? "–" : "+"}</span>
              </button>
              <div class:list={["faq-panel", item.open && "is-open"]} inert={!item.open}>
                <div><p class="pb-lg text-editorial-muted max-w-[40rem] leading-relaxed">{item.answer}</p></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter portalUrl={portalUrl} clinicName={clinicName} phone={phone} hours={hours} address={address} services={services.map((service) => service.name)} />

  <div class="lg:hidden fixed bottom-0 inset-x-0 z-30 bg-surface/95 backdrop-blur-md border-t border-editorial-border px-lg py-sm flex items-center justify-between gap-md">
    <span class="text-[14px]">Open times</span>
    <a href="#book" class="btn-ink h-10 px-lg text-[14px]">Book</a>
  </div>

  <div id="command" hidden class="fixed inset-0 z-50 bg-night/50 p-lg flex items-start justify-center pt-[12vh]">
    <div id="command-panel" role="dialog" aria-modal="true" aria-label="Jump to a section" class="w-full max-w-[32rem] bg-surface border-t-2 border-gold shadow-[0_24px_60px_rgba(16,20,22,0.18)]">
      <input id="command-input" class="w-full h-14 px-lg bg-transparent border-b border-editorial-border text-[16px]" placeholder="Jump to care, doctors, visit, questions, or booking" />
      <ul id="command-list" class="py-sm"></ul>
    </div>
  </div>

  <script>
    const motion = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.querySelectorAll<HTMLImageElement>("img.media").forEach((image) => {
      const sharpen = () => image.classList.add("is-sharp");
      if (image.complete && image.naturalWidth > 0) sharpen();
      else {
        image.addEventListener("load", sharpen, { once: true });
        image.addEventListener("error", sharpen, { once: true });
      }
    });

    const menuButton = document.getElementById("menu-button");
    const menuPanel = document.getElementById("menu-panel");
    menuButton?.addEventListener("click", () => {
      if (!menuPanel || !menuButton) return;
      const open = menuPanel.hasAttribute("hidden");
      menuPanel.toggleAttribute("hidden", !open);
      menuButton.setAttribute("aria-expanded", String(open));
      menuButton.querySelector(".sr-only")!.textContent = open ? "Close menu" : "Open menu";
    });
    menuPanel?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menuPanel.setAttribute("hidden", "");
        menuButton?.setAttribute("aria-expanded", "false");
      });
    });

    const form = document.getElementById("book");
    const dateInput = form?.querySelector<HTMLInputElement>('input[name="date"]');
    if (dateInput && !dateInput.value) {
      dateInput.value = new Intl.DateTimeFormat("en-CA", {
        timeZone: "Asia/Karachi",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      }).format(new Date());
    }

    document.querySelectorAll<HTMLAnchorElement>(".pick-doctor").forEach((link) => {
      link.addEventListener("click", () => {
        const select = form?.querySelector<HTMLSelectElement>('select[name="doctorId"]');
        const doctorId = link.dataset.pickDoctor;
        if (select && doctorId) select.value = doctorId;
      });
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      const results = document.getElementById("availability-results");
      if (!results) return;
      results.hidden = false;
      const data = new FormData(form);
      const date = String(data.get("date") ?? "");
      const doctorId = String(data.get("doctorId") ?? "");
      const department = String(data.get("department") ?? "");
      const allowed = new Set(
        [...form.querySelectorAll<HTMLOptionElement>('select[name="doctorId"] option')]
          .filter((option) => option.value && (!department || option.dataset.department === department))
          .map((option) => option.value),
      );
      const params = new URLSearchParams({ from: date, to: date });
      if (doctorId) params.set("doctorId", doctorId);
      results.setAttribute("aria-busy", "true");
      results.innerHTML = `<p class="sr-only">Looking up published slots</p><div class="flex flex-col gap-sm" aria-hidden="true"><span class="shimmer"></span><span class="shimmer"></span><span class="shimmer"></span></div>`;
      const paint = (draw: () => void) => {
        const view = document as Document & { startViewTransition?: (update: () => void) => void };
        if (motion && view.startViewTransition) view.startViewTransition(draw);
        else draw();
      };
      try {
        if (!navigator.onLine) throw new Error("offline");
        const response = await fetch(`${form.dataset.apiBase ?? ""}/api/v1/public/availability?${params}`);
        const body = (await response.json()) as {
          data?: { slotId: string; doctorId: string; startAt: string }[];
          error?: { message: string };
        };
        if (!response.ok || !body.data) {
          paint(() => { results.textContent = body.error?.message ?? "Open times could not be loaded."; });
          return;
        }
        const names = new Map(
          [...form.querySelectorAll<HTMLOptionElement>('select[name="doctorId"] option')].map((option) => [option.value, option.textContent ?? "Doctor"]),
        );
        const slots = body.data.filter((slot) => !department || allowed.has(slot.doctorId));
        paint(() => {
          if (slots.length === 0) {
            results.textContent = "No open slots on that date.";
            return;
          }
          const list = document.createElement("ul");
          list.className = "flex flex-col";
          slots.forEach((slot, index) => {
            const item = document.createElement("li");
            item.className = "slot-row border-t border-editorial-border";
            item.style.animationDelay = `${index * 40}ms`;
            const link = document.createElement("a");
            const when = new Intl.DateTimeFormat("en-PK", {
              timeZone: "Asia/Karachi",
              hour: "numeric",
              minute: "2-digit",
            }).format(new Date(slot.startAt));
            link.href = `${form.dataset.portalUrl}/patient?doctorId=${encodeURIComponent(slot.doctorId)}&slotId=${encodeURIComponent(slot.slotId)}`;
            link.className = "flex items-center justify-between gap-md py-sm font-label hover:text-primary";
            link.dataset.warm = link.href;
            link.innerHTML = `<span>${when}</span><span class="text-primary">Confirm</span>`;
            link.setAttribute("aria-label", `Confirm ${when} with ${names.get(slot.doctorId) ?? "this doctor"}`);
            link.addEventListener("pointerenter", () => warm(link.href));
            link.addEventListener("click", () => {
              link.querySelector("span:last-child")!.textContent = "Opening confirmation…";
            });
            item.append(link);
            list.append(item);
          });
          results.replaceChildren(list);
        });
      } catch {
        paint(() => { results.textContent = "The clinic service is not reachable right now. The form is still here when it returns."; });
      } finally {
        results.removeAttribute("aria-busy");
      }
    });

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible" && resultsWereShown() && form instanceof HTMLFormElement) form.requestSubmit();
    });

    function resultsWereShown() {
      const results = document.getElementById("availability-results");
      return Boolean(results && !results.hidden && results.childElementCount > 0);
    }

    function warm(url: string) {
      if (document.head.querySelector(`link[href="${CSS.escape(url)}"]`)) return;
      const link = document.createElement("link");
      link.rel = "prefetch";
      link.href = url;
      document.head.append(link);
    }

    const portalOrigin = form instanceof HTMLFormElement ? form.dataset.portalUrl : "";
    if (portalOrigin) {
      const origin = document.createElement("link");
      origin.rel = "preconnect";
      origin.href = new URL(portalOrigin).origin;
      document.head.append(origin);
    }

    document.querySelectorAll<HTMLButtonElement>(".faq-toggle").forEach((button) => {
      button.addEventListener("click", () => {
        const panel = button.parentElement?.querySelector(".faq-panel");
        const icon = button.querySelector(".faq-icon");
        const expanded = button.getAttribute("aria-expanded") === "true";
        button.setAttribute("aria-expanded", String(!expanded));
        panel?.classList.toggle("is-open", !expanded);
        if (panel instanceof HTMLElement) panel.inert = expanded;
        if (icon) icon.textContent = expanded ? "+" : "–";
      });
    });

    const commands = [
      ["Care", "#care"],
      ["Doctors", "#doctors"],
      ["Visit", "#visit"],
      ["Questions", "#questions"],
      ["Book a time", "#book"],
    ];
    const command = document.getElementById("command");
    const commandInput = document.getElementById("command-input");
    const commandList = document.getElementById("command-list");

    function renderCommands(query: string) {
      if (!commandList) return;
      const matches = commands.filter(([label]) => label.toLowerCase().includes(query.toLowerCase()));
      commandList.replaceChildren();
      for (const [label, href] of matches) {
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = href;
        link.className = "block px-lg py-sm hover:bg-ivory";
        link.textContent = label;
        link.addEventListener("click", () => command?.setAttribute("hidden", ""));
        item.append(link);
        commandList.append(item);
      }
    }

    function openCommand() {
      command?.removeAttribute("hidden");
      if (commandInput instanceof HTMLInputElement) {
        commandInput.value = "";
        commandInput.focus();
      }
      renderCommands("");
    }

    commandInput?.addEventListener("input", () => {
      if (commandInput instanceof HTMLInputElement) renderCommands(commandInput.value);
    });
    command?.addEventListener("click", (event) => {
      if (event.target === command) command.setAttribute("hidden", "");
    });

    window.addEventListener("keydown", (event) => {
      const typing = event.target instanceof HTMLElement && Boolean(event.target.closest("input, textarea, select"));
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        openCommand();
        return;
      }
      if (event.key === "Escape") command?.setAttribute("hidden", "");
      if (!typing && event.key.toLowerCase() === "b") {
        event.preventDefault();
        document.getElementById("book")?.scrollIntoView({ block: "center" });
        form?.querySelector<HTMLSelectElement>('select[name="doctorId"]')?.focus();
      }
    });
  </script>
</Base>

---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { faqs, portalUrl } from "../data/clinic";
import { loadCatalog } from "../lib/catalog";

const { clinic } = await loadCatalog();
const clinicName = clinic?.name ?? "Mardan Eye Clinic";
const phone = clinic?.phone ?? null;
const address = clinic?.address ?? "Street address not listed";
const directions = clinic?.address
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${clinicName}, ${clinic.address}`)}`
  : null;
const steps = [
  { title: "Find a time", text: "Choose a doctor and day to see available appointments." },
  { title: "Confirm your visit", text: "Sign in to reserve a time and get your booking reference." },
  { title: "Check in at reception", text: "Bring your booking reference, glasses and any previous eye reports you have." },
];
---

<Base title={`Plan your visit | ${clinicName}`} description="Find the clinic's address and hours, what to bring, and answers to common questions.">
  <SiteHeader {portalUrl} {clinicName} />
  <main id="main-content" tabindex="-1">
    <section class="page-intro section-tint">
      <div class="wrap">
        <p class="eyebrow">Clinic information</p>
        <h1>Plan your visit.</h1>
        <p class="intro">Find the clinic and know what to bring to your appointment.</p>
      </div>
    </section>
    <section class="section wrap visit-grid" aria-label="Visit and location details">
      <ol class="visit-steps" role="list">
        {steps.map((step, index) => (
          <li><span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <div><h2>{step.title}</h2><p>{step.text}</p></div>
          </li>
        ))}
      </ol>
      <div class="location">
        <p class="eyebrow">Find the clinic</p>
        <h2>{clinicName}</h2>
        <dl>
          <div><dt>Address</dt><dd>{address}</dd></div>
          <div><dt>Hours</dt><dd>{clinic?.hoursSummary ?? "Hours not listed"}</dd></div>
          {phone && <div><dt>Phone</dt><dd><a href={`tel:${phone}`}>{phone}</a></dd></div>}
        </dl>
        {directions && <a class="button light" href={directions}>Get directions <span aria-hidden="true">↗</span></a>}
      </div>
    </section>
    <section id="questions" class="section section-tint" aria-labelledby="questions-title">
      <div class="wrap faq-grid">
        <div>
          <p class="eyebrow">FAQs</p>
          <h2 id="questions-title">Before you come.</h2>
        </div>
        <div class="faq-list">
          {faqs.map((item) => (
            <details open={item.open}>
              <summary>{item.question}<span aria-hidden="true"></span></summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter {portalUrl} {clinicName} {phone} {address} />
</Base>

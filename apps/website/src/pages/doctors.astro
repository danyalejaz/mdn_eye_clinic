---
import PatientPage from "../layouts/PatientPage.astro";
import { loadCatalog, formatFee } from "../lib/catalog";
const { clinic, doctors } = await loadCatalog();
---
<PatientPage {clinic} label="Doctors" title="Find your eye doctor" description="Compare specialties, qualifications and consultation fees. Choose a doctor below to check appointment times.">
  <section class="wrap section reading-grid">
    <div>
      <p class="eyebrow">Doctor directory</p>
      <h2>Consulting doctors</h2>
      <ul class="directory-list" role="list">
        {doctors.map(doctor => <li>
          {doctor.photoUrl && <img class="profile-thumb" src={doctor.photoUrl} width="88" height="100" alt="" loading="lazy" />}
          <p class="card-label">{doctor.departmentName}</p>
          <h3>{doctor.displayName}</h3>
          <p>{doctor.specialty}{doctor.qualifications && ` · ${doctor.qualifications}`}</p>
          <p>Consultation: <strong>{formatFee(doctor.feeMinor)}</strong></p>
          <a class="text-link" href={`/appointments/?doctorId=${encodeURIComponent(doctor.id)}#book`}>Check times <span class="visually-hidden">with {doctor.displayName}</span> →</a>
        </li>)}
      </ul>
      {!doctors.length && <p class="empty">Doctor listings are unavailable. Contact reception for help choosing a doctor.</p>}
    </div>
    <aside class="reading-note"><h2>Coming back?</h2><p>If you want to see the same doctor again, look for their name on your previous appointment reference. Bring any reports they asked to review.</p><a class="text-link" href="/patient-guide/">Prepare for your visit →</a></aside>
  </section>
</PatientPage>

---
import PatientPage from "../layouts/PatientPage.astro";
import { loadCatalog, formatFee } from "../lib/catalog";
const { clinic, services } = await loadCatalog();
---
<PatientPage {clinic} label="Services" title="Services and fees" description="See what the clinic offers and check the published fee before arranging your visit. Prices are listed in Pakistani rupees.">
  <section class="wrap section reading-grid">
    <div>
      <p class="eyebrow">Service directory</p>
      <h2>Available at the clinic</h2>
      {services.length ? <dl class="directory-list">
        {services.map(service => <div id={service.slug}>
          <dt><small>{service.departmentName}</small>{service.name}</dt>
          <dd>{service.description && <p>{service.description}</p>}Published fee: <strong>{formatFee(service.feeMinor)}</strong></dd>
        </div>)}
      </dl> : <p class="empty">The service list is unavailable. Contact reception to check services and fees.</p>}
    </div>
    <aside class="reading-note">
      <h2>Before you book</h2>
      <p>A service fee and a doctor’s consultation fee are listed separately. If you are budgeting for a visit, ask reception which charges apply to you.</p>
      <a class="text-link" href="/doctors/">Compare consultation fees →</a>
      <a class="text-link" href="/visit/">Contact and opening hours →</a>
    </aside>
  </section>
</PatientPage>

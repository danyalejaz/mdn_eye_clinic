---
import Base from "../layouts/Base.astro";
import Booking from "../components/Booking.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { portalUrl, launchMode } from "../data/clinic";
import { loadCatalog } from "../lib/catalog";

const { clinic, doctors } = await loadCatalog();
const clinicName = clinic?.name ?? "Mardan Eye Clinic";
const phone = clinic?.phone ?? null;
const address = clinic?.address ?? "Street address not listed";
---

<Base title={`Appointments | ${clinicName}`} description="Find an available appointment at the clinic or sign in to manage a visit you've already booked.">
  <SiteHeader {portalUrl} {clinicName} />
  <main id="main-content" tabindex="-1">
    <section class="page-intro section-tint">
      <div class="wrap">
        <p class="eyebrow">Appointments</p>
        <h1>Book an eye appointment.</h1>
        <p class="intro">{launchMode ? "Online booking is not yet available. Please contact the clinic to arrange your appointment." : "Choose a doctor and date. Sign in to confirm an available time and get a booking reference."}</p>
      </div>
    </section>
    <div class="section wrap appointment-page">
      {launchMode ? <div class="booking"><h2>Contact the clinic</h2><p>Call <a href="tel:0937867538">0937-867538</a> or WhatsApp <a href="https://wa.me/923015801666">0301-5801666</a>.</p></div> : <Booking {doctors} {portalUrl} />}
      {!launchMode && <>
      <section class="booking-help" aria-labelledby="confirmation-help">
        <h2 id="confirmation-help">When is my time confirmed?</h2>
        <p>Selecting a time opens patient sign-in; it does not reserve the slot. Confirm the visit in your account and keep the booking reference for reception. If a time is no longer available, check another date.</p>
      </section>
      <div class="actions">
        <a class="text-link" href={`${portalUrl}/sign-in`}>Manage an existing appointment <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/visit/">Plan your visit <span aria-hidden="true">→</span></a>
      </div>
      </>}
    </div>
  </main>
  <SiteFooter {portalUrl} {clinicName} {phone} {address} />
</Base>

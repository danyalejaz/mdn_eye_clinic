---
import Mark from "./Mark.astro";

interface Props {
  clinicName: string;
  phone: string | null;
  address: string;
}

const { clinicName, phone, address } = Astro.props;
const isBookingPage = Astro.url.pathname.replace(/\/$/, "") === "/appointments";
---

<footer class="site-footer">
  <div class="wrap">
    {!isBookingPage && <div class="footer-top">
      <div>
        <p class="eyebrow">Your next visit</p>
        <h2>Ready to book?</h2>
      </div>
      <a href="/appointments/" class="button light">Find an appointment <span aria-hidden="true">↗</span></a>
    </div>}
    <div class="footer-main">
      <div>
        <a href="/" class="brand"><Mark /><span>{clinicName}<small>Eye care in Mardan</small></span></a>
        <p>{address}</p>
        {phone && <a href={`tel:${phone}`}>{phone}</a>}
      </div>
      <nav aria-label="Footer navigation">
        <a href="/services/">Eye care services</a>
        <a href="/doctors/">Find a doctor</a>
        <a href="/patient-guide/">Patient guide</a>
        <a href="/visit/">Plan your visit</a>
        <a href="/visit/#questions">Patient questions</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} {clinicName}</p>
      <p>Scheduled outpatient visits only. This is not an emergency service.</p>
    </div>
  </div>
</footer>

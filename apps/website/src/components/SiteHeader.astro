---
import Mark from "./Mark.astro";

interface Props {
  clinicName: string;
}

const { clinicName } = Astro.props;
const links = [
  { href: "/services/", label: "Services and fees" },
  { href: "/doctors/", label: "Our doctors" },
  { href: "/patient-guide/", label: "Patient guide" },
  { href: "/visit/", label: "Your visit" },
];
---

<header class="site-header">
  <div class="wrap header-row">
    <a href="/" class="brand"><Mark /><span>{clinicName}<small>Eye care in Mardan</small></span></a>
    <div class="header-actions">
      <a href="/appointments/" class="button primary">Book a visit</a>
      <details class="mobile-nav">
        <summary>
          <span class="visually-hidden">Navigation menu</span>
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <nav aria-label="Mobile navigation">
          {links.map(({ href, label }) => <a {href} aria-current={Astro.url.pathname === href ? "page" : undefined}>{label}</a>)}
          <a href="/appointments/">Book a visit</a>
        </nav>
      </details>
    </div>
  </div>
  <nav class="desktop-nav wrap" aria-label="Main navigation">
    {links.map(({ href, label }) => <a {href} aria-current={Astro.url.pathname === href ? "page" : undefined}>{label}</a>)}
  </nav>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-nav");
  menu?.addEventListener("click", (event) => {
    if (event.target instanceof HTMLAnchorElement) menu.open = false;
  });
  menu?.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !menu.open) return;
    menu.open = false;
    menu.querySelector("summary")?.focus();
  });
</script>

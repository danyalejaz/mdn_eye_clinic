---
import type { PublicDoctor } from "../lib/catalog";

interface Props {
  doctors: PublicDoctor[];
  portalUrl: string;
}

const { doctors, portalUrl } = Astro.props;
const departments = [...new Map(doctors.map((doctor) => [doctor.departmentSlug, doctor.departmentName]))];
---

<section id="book" class="booking" aria-labelledby="booking-title">
  <div class="booking-title">
    <span class="booking-icon" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <rect x="4" y="6" width="16" height="14" rx="3" /><path d="M8 4v4m8-4v4M4 11h16m-11 4h2m2 0h2" />
      </svg>
    </span>
    <div><h2 id="booking-title">Find a time</h2><p>Confirm your visit in the patient portal.</p></div>
  </div>
  <form id="availability-form" data-portal-url={portalUrl} data-api-base={import.meta.env.PUBLIC_API_URL ?? ""}>
    <div class="booking-field">
      <label for="availability-department">Department</label>
      <select id="availability-department" name="department">
        <option value="">All departments</option>
        {departments.map(([slug, name]) => <option value={slug}>{name}</option>)}
      </select>
    </div>
    <div class="booking-field">
      <label for="availability-doctor">Doctor</label>
      <select id="availability-doctor" name="doctorId">
        <option value="">Any doctor</option>
        {doctors.map((doctor) => <option value={doctor.id} data-department={doctor.departmentSlug}>{doctor.displayName}</option>)}
      </select>
    </div>
    <div class="booking-field">
      <label for="availability-date">Date</label>
      <input id="availability-date" type="date" name="date" required />
    </div>
    <button type="submit" class="button primary">Check availability <span aria-hidden="true">→</span></button>
  </form>
  <noscript><p class="booking-note">JavaScript is required to check availability here. <a href={`${portalUrl}/sign-in`}>Open the patient portal.</a></p></noscript>
  <p id="availability-status" role="status"></p>
  <ul id="availability-results" aria-label="Available appointment times" role="list"></ul>
</section>

<script>
  type Slot = { slotId: string; doctorId: string; startAt: string };
  const form = document.querySelector<HTMLFormElement>("#availability-form")!;
  const department = form.querySelector<HTMLSelectElement>('[name="department"]')!;
  const doctor = form.querySelector<HTMLSelectElement>('[name="doctorId"]')!;
  const date = form.querySelector<HTMLInputElement>('[name="date"]')!;
  const status = document.getElementById("availability-status")!;
  const results = document.getElementById("availability-results")!;
  const doctors = new Map([...doctor.options].filter((option) => option.value).map((option) => [option.value, option]));
  const time = new Intl.DateTimeFormat("en-PK", { timeZone: "Asia/Karachi", hour: "numeric", minute: "2-digit" });
  const today = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Karachi", year: "numeric", month: "2-digit", day: "2-digit" }).format(new Date());
  date.min = today;
  if (!date.value) date.value = today;

  let pending: AbortController | undefined;

  function filterDoctors() {
    for (const option of doctors.values()) {
      option.hidden = option.disabled = Boolean(department.value && option.dataset.department !== department.value);
    }
    if (doctor.selectedOptions[0]?.disabled) doctor.value = "";
  }

  function clearResults() {
    pending?.abort();
    results.replaceChildren();
    status.textContent = "";
  }

  department.addEventListener("change", filterDoctors);
  form.addEventListener("change", clearResults);
  document.querySelectorAll<HTMLAnchorElement>("[data-pick-doctor]").forEach((link) => {
    link.addEventListener("click", () => {
      const option = doctors.get(link.dataset.pickDoctor ?? "");
      if (!option) return;
      department.value = option.dataset.department ?? "";
      filterDoctors();
      doctor.value = option.value;
      clearResults();
      requestAnimationFrame(() => date.focus({ preventScroll: true }));
    });
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    clearResults();
    const request = new AbortController();
    pending = request;
    const selectedDepartment = department.value;
    const selectedDate = date.value;
    const params = new URLSearchParams({ from: selectedDate, to: selectedDate });
    if (doctor.value) params.set("doctorId", doctor.value);
    status.textContent = "Checking available times…";

    try {
      const response = await fetch(`${form.dataset.apiBase}/api/v1/public/availability?${params}`, { signal: request.signal });
      const body = await response.json() as { data?: Slot[]; error?: { message: string } };
      if (request.signal.aborted) return;
      if (!response.ok || !Array.isArray(body.data)) {
        status.textContent = body.error?.message ?? "Available times could not be loaded. Try again.";
        return;
      }
      const slots = body.data.filter((slot) => !selectedDepartment || doctors.get(slot.doctorId)?.dataset.department === selectedDepartment);
      status.textContent = slots.length
        ? `${slots.length} ${slots.length === 1 ? "time" : "times"} available. All times are local to Mardan.`
        : "No appointments are available on this date. Try another date or doctor.";

      results.replaceChildren(...slots.map((slot) => {
        const row = document.createElement("li");
        const link = document.createElement("a");
        const when = time.format(new Date(slot.startAt));
        const name = doctors.get(slot.doctorId)?.label;
        const query = new URLSearchParams({ doctorId: slot.doctorId, slotId: slot.slotId, date: selectedDate });
        link.href = `${form.dataset.portalUrl}/patient?${query}`;
        const label = document.createElement("span");
        label.textContent = name ? `${when} · ${name}` : when;
        const action = document.createElement("strong");
        action.textContent = "Continue ↗";
        link.append(label, action);
        row.append(link);
        return row;
      }));
    } catch {
      if (!request.signal.aborted) status.textContent = "Appointment availability is temporarily unavailable. Try again shortly.";
    }
  });
</script>

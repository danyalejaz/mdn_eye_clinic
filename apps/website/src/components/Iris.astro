---
const fibers = Array.from({ length: 128 }, (_, index) => ({
  angle: index * 360 / 128,
  length: 105 + 37 * Math.sin(index * 2.4) + 18 * Math.cos(index * .67),
  opacity: .17 + .61 * (1 + Math.sin(index * 4.1)) / 2,
}));
---

<svg viewBox="0 0 560 470" fill="none" class="iris">
  <defs>
    <radialGradient id="iris-base">
      <stop offset=".32" stop-color="#071637" />
      <stop offset=".52" stop-color="#172eb3" />
      <stop offset=".75" stop-color="#486aff" />
      <stop offset=".92" stop-color="#1534c5" />
      <stop offset="1" stop-color="#060e40" />
    </radialGradient>
    <linearGradient id="iris-light" x1="0" y1="-166" x2="0" y2="-59" gradientUnits="userSpaceOnUse">
      <stop stop-color="#b5e5ff" stop-opacity=".12" />
      <stop offset=".48" stop-color="#90c5ff" />
      <stop offset="1" stop-color="#bcaaff" stop-opacity=".25" />
    </linearGradient>
    <linearGradient id="lens-glow" x1="-160" y1="-141" x2="158" y2="122" gradientUnits="userSpaceOnUse">
      <stop stop-color="#b4caff" stop-opacity=".48" />
      <stop offset=".48" stop-color="#769bff" stop-opacity="0" />
      <stop offset="1" stop-color="#a76bff" stop-opacity=".28" />
    </linearGradient>
  </defs>
  <g transform="translate(280 235)">
    <g stroke="#becbff" stroke-opacity=".45">
      <circle r="205" stroke-dasharray="1 5" />
      <circle r="185" />
      <path d="M-250 0h46m408 0h46M0-227v23m0 408v23M-179-179l34 34m290 290 34 34m0-358-34 34m-290 290-34 34" />
      <ellipse rx="238" ry="119" transform="rotate(-25)" />
      <ellipse rx="237" ry="130" transform="rotate(25)" stroke-opacity=".22" />
    </g>
    <circle r="168" fill="#0c1852" stroke="#a6c0ff" stroke-width="2" />
    <circle r="162" fill="url(#iris-base)" />
    {fibers.map(({ angle, length, opacity }) => (
      <path d={`M0 -161 Q ${length / 12} -116 -3 ${-length / 2.15}`} transform={`rotate(${angle})`} stroke="url(#iris-light)" stroke-width="1.25" opacity={opacity} />
    ))}
    <circle r="147" stroke="#9cc9ff" stroke-opacity=".36" stroke-dasharray="1 3" />
    <circle r="114" stroke="#a59bff" stroke-opacity=".42" stroke-dasharray="2 6" />
    <circle r="66" fill="#080e32" stroke="#9aaaff" stroke-opacity=".7" />
    <circle r="52" fill="#060a23" />
    <circle r="162" fill="url(#lens-glow)" />
    <path d="M-111-106a155 155 0 0 1 99-44" stroke="#d5e2ff" stroke-width="2" stroke-linecap="round" opacity=".78" />
    <path d="M79 125a149 149 0 0 0 43-42" stroke="#bdb1ff" stroke-width="2" stroke-linecap="round" opacity=".57" />
    <circle cx="-205" cy="0" r="3" fill="#d8e1ff" />
    <circle cx="0" cy="205" r="3" fill="#d8e1ff" />
    <circle cx="215" cy="-92" r="3" fill="#c1d5ff" />
  </g>
</svg>
